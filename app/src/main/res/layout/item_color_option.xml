<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/padding_spacing_dp16"
    android:paddingEnd="@dimen/padding_spacing_dp16">

    <View
        android:id="@+id/color_preview"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_color_swatch" />

    <TextView
        android:id="@+id/color_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_spacing_dp12"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/md_theme_onSurface"
        android:textSize="14sp"
        tools:text="Accent" />

    <TextView
        android:id="@+id/color_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.02"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:textSize="12sp"
        tools:text="#2F81F7" />
</LinearLayout>
