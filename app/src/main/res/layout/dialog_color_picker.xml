<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_color_picker_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/padding_spacing_dp20"
    android:paddingTop="@dimen/padding_spacing_dp8"
    android:paddingEnd="@dimen/padding_spacing_dp20"
    android:paddingBottom="@dimen/padding_spacing_dp20">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:id="@+id/picker_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_spacing_dp16"
        android:fontFamily="sans-serif-medium"
        android:textColor="?attr/colorOnSurface"
        android:textSize="18sp"
        tools:text="Accent" />

    <com.v2plus.app.ui.SaturationValueView
        android:id="@+id/picker_sv"
        android:layout_width="match_parent"
        android:layout_height="168dp"
        android:layout_marginTop="@dimen/padding_spacing_dp16" />

    <com.v2plus.app.ui.HueBarView
        android:id="@+id/picker_hue"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="@dimen/padding_spacing_dp16" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_spacing_dp16"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/picker_preview"
            android:layout_width="44dp"
            android:layout_height="44dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_spacing_dp12"
            android:layout_weight="1"
            android:background="@drawable/bg_cust_hex_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/padding_spacing_dp12"
            android:paddingTop="@dimen/padding_spacing_dp8"
            android:paddingEnd="@dimen/padding_spacing_dp12"
            android:paddingBottom="@dimen/padding_spacing_dp8">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="#"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/picker_hex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:fontFamily="monospace"
                android:hint="RRGGBB"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters"
                android:maxLength="6"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:textSize="16sp"
                tools:text="2F81F7" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_spacing_dp20"
        android:layout_marginBottom="@dimen/padding_spacing_dp8"
        android:fontFamily="sans-serif-medium"
        android:text="@string/cust_picker_suggested"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp" />

    <GridLayout
        android:id="@+id/picker_swatches"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alignmentMode="alignMargins"
        android:columnCount="6"
        android:useDefaultMargins="false" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/picker_done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_spacing_dp16"
        android:text="@string/cust_picker_done"
        android:textAllCaps="false" />

</LinearLayout>
