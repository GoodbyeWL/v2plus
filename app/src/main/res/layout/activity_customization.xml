<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/padding_spacing_dp16"
        android:paddingTop="@dimen/padding_spacing_dp8"
        android:paddingEnd="@dimen/padding_spacing_dp16"
        android:paddingBottom="@dimen/padding_spacing_dp24">

        <TextView
            style="@style/CustSectionTitle"
            android:text="@string/cust_preview" />

        <FrameLayout
            android:id="@+id/preview_stage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_spacing_dp16">

                <LinearLayout
                    android:id="@+id/preview_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/padding_spacing_dp16"
                    android:paddingTop="@dimen/padding_spacing_dp12"
                    android:paddingEnd="@dimen/padding_spacing_dp16"
                    android:paddingBottom="@dimen/padding_spacing_dp12">

                    <TextView
                        android:id="@+id/preview_brand"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/app_name"
                        android:textSize="16sp"
                        tools:text="V2plus" />

                    <View
                        android:id="@+id/preview_header_dot"
                        android:layout_width="8dp"
                        android:layout_height="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/preview_sample_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/padding_spacing_dp12"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/padding_spacing_dp12"
                    android:paddingTop="@dimen/padding_spacing_dp12"
                    android:paddingEnd="@dimen/padding_spacing_dp16"
                    android:paddingBottom="@dimen/padding_spacing_dp12">

                    <View
                        android:id="@+id/preview_accent_bar"
                        android:layout_width="4dp"
                        android:layout_height="36dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/padding_spacing_dp12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/preview_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/cust_preview_sample_title"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/preview_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/cust_preview_connected"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <TextView
            style="@style/CustSectionTitle"
            android:layout_marginTop="@dimen/padding_spacing_dp24"
            android:text="@string/cust_presets" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_presets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            tools:itemCount="4"
            tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            tools:listitem="@layout/item_theme_preset"
            tools:spanCount="2" />

        <TextView
            style="@style/CustSectionTitle"
            android:layout_marginTop="@dimen/padding_spacing_dp24"
            android:text="@string/cust_bg_image" />

        <LinearLayout
            android:id="@+id/surface_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/padding_spacing_dp12"
            android:paddingTop="@dimen/padding_spacing_dp12"
            android:paddingEnd="@dimen/padding_spacing_dp8"
            android:paddingBottom="@dimen/padding_spacing_dp12">

            <ImageView
                android:id="@+id/img_bg_thumb"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/cust_bg_image"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tv_bg_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/padding_spacing_dp12"
                android:layout_weight="1"
                android:text="@string/cust_bg_none"
                android:textColor="@color/md_theme_onSurface"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btn_bg_gallery"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_cust_icon_btn"
                android:contentDescription="@string/cust_bg_from_gallery"
                android:src="@drawable/ic_image_24dp" />

            <ImageButton
                android:id="@+id/btn_bg_url"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/padding_spacing_dp4"
                android:background="@drawable/bg_cust_icon_btn"
                android:contentDescription="@string/cust_bg_from_url"
                android:src="@drawable/ic_cloud_download_24dp" />

            <ImageButton
                android:id="@+id/btn_bg_clear"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/padding_spacing_dp4"
                android:background="@drawable/bg_cust_icon_btn"
                android:contentDescription="@string/cust_bg_clear"
                android:src="@drawable/ic_delete_24dp" />
        </LinearLayout>

        <TextView
            style="@style/CustSectionTitle"
            android:layout_marginTop="@dimen/padding_spacing_dp24"
            android:text="@string/cust_colors" />

        <LinearLayout
            android:id="@+id/surface_colors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/padding_spacing_dp8"
            android:paddingBottom="@dimen/padding_spacing_dp12">

            <TextView
                style="@style/CustGroupLabel"
                android:paddingTop="@dimen/padding_spacing_dp12"
                android:text="@string/cust_group_accent" />

            <include
                android:id="@+id/opt_accent"
                layout="@layout/item_color_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/padding_spacing_dp4" />

            <TextView
                style="@style/CustGroupLabel"
                android:text="@string/cust_group_background" />

            <include
                android:id="@+id/opt_bg_start"
                layout="@layout/item_color_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/padding_spacing_dp4" />

            <include
                android:id="@+id/opt_bg_center"
                layout="@layout/item_color_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/padding_spacing_dp4" />

            <include
                android:id="@+id/opt_bg_end"
                layout="@layout/item_color_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/padding_spacing_dp4" />

            <TextView
                style="@style/CustGroupLabel"
                android:text="@string/cust_group_surfaces" />

            <include
                android:id="@+id/opt_card"
                layout="@layout/item_color_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/padding_spacing_dp4" />

            <include
                android:id="@+id/opt_card_stroke"
                layout="@layout/item_color_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/padding_spacing_dp4" />

            <include
                android:id="@+id/opt_header_start"
                layout="@layout/item_color_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/padding_spacing_dp4" />

            <include
                android:id="@+id/opt_header_end"
                layout="@layout/item_color_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/padding_spacing_dp4" />

            <TextView
                style="@style/CustGroupLabel"
                android:text="@string/cust_group_text" />

            <include
                android:id="@+id/opt_text_primary"
                layout="@layout/item_color_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/padding_spacing_dp4" />

            <include
                android:id="@+id/opt_text_secondary"
                layout="@layout/item_color_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/padding_spacing_dp4" />

            <include
                android:id="@+id/opt_text_tertiary"
                layout="@layout/item_color_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/padding_spacing_dp4" />

            <include
                android:id="@+id/opt_icon_color"
                layout="@layout/item_color_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/padding_spacing_dp4" />

            <TextView
                style="@style/CustGroupLabel"
                android:text="@string/cust_group_status" />

            <include
                android:id="@+id/opt_success_color"
                layout="@layout/item_color_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/padding_spacing_dp4" />

            <include
                android:id="@+id/opt_error_color"
                layout="@layout/item_color_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/padding_spacing_dp4" />

            <include
                android:id="@+id/opt_warning_color"
                layout="@layout/item_color_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/padding_spacing_dp4" />
        </LinearLayout>

        <TextView
            style="@style/CustSectionTitle"
            android:layout_marginTop="@dimen/padding_spacing_dp24"
            android:text="@string/cust_fonts" />

        <LinearLayout
            android:id="@+id/surface_fonts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_spacing_dp16">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_font_family"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/cust_font_family"
                app:boxStrokeWidth="1dp"
                app:hintEnabled="true">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/dropdown_font_family"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_spacing_dp16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/CustSliderLabel"
                    android:text="@string/cust_font_scale" />

                <TextView
                    android:id="@+id/tv_font_scale_value"
                    style="@style/CustSliderValue"
                    tools:text="100%" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_font_scale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="60"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progress="20" />

            <TextView
                android:id="@+id/tv_font_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_spacing_dp8"
                android:text="@string/cust_font_preview"
                android:textColor="@color/md_theme_onSurface"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            style="@style/CustSectionTitle"
            android:layout_marginTop="@dimen/padding_spacing_dp24"
            android:text="@string/cust_shape" />

        <LinearLayout
            android:id="@+id/surface_shape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_spacing_dp16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/CustSliderLabel"
                    android:text="@string/cust_card_radius" />

                <TextView
                    android:id="@+id/tv_card_radius"
                    style="@style/CustSliderValue"
                    tools:text="24" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_card_radius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="48"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progress="24" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_spacing_dp12"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/CustSliderLabel"
                    android:text="@string/cust_header_radius" />

                <TextView
                    android:id="@+id/tv_header_radius"
                    style="@style/CustSliderValue"
                    tools:text="28" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_header_radius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="48"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progress="28" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_spacing_dp12"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/CustSliderLabel"
                    android:text="@string/cust_server_radius" />

                <TextView
                    android:id="@+id/tv_server_radius"
                    style="@style/CustSliderValue"
                    tools:text="24" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_server_radius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="48"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progress="24" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_spacing_dp12"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/CustSliderLabel"
                    android:text="@string/cust_drawer_radius" />

                <TextView
                    android:id="@+id/tv_drawer_radius"
                    style="@style/CustSliderValue"
                    tools:text="16" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_drawer_radius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="48"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progress="16" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_spacing_dp12"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/CustSliderLabel"
                    android:text="@string/cust_bg_overlay_strength" />

                <TextView
                    android:id="@+id/tv_bg_overlay"
                    style="@style/CustSliderValue"
                    tools:text="59%" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_bg_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="255"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progress="150" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_spacing_dp16"
            android:text="@string/cust_reset"
            android:textAllCaps="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
