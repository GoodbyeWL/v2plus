    <string name="title_pref_per_app_proxy">Прокси по приложениям</string>
    <string name="summary_pref_per_app_proxy">Основной: выбранное приложение соединяется через прокси, не выбранное — напрямую;\nРежим обхода: выбранное приложение соединяется напрямую, не выбранное — через прокси.\nЕсть возможность автоматического выбора проксируемых приложений в меню.</string>
    <string name="title_pref_local_port_protection">Защита авторизации локального прокси</string>
    <string name="summary_pref_local_port_protection">Случайные логин и пароль при каждом запуске, если не заданы свои ниже. Защищает локальный SOCKS/HTTP от посторонних приложений.</string>
    <string name="title_pref_local_proxy_username">Логин локального прокси</string>
    <string name="summary_pref_local_proxy_username">Необязательно. Оставьте пустым вместе с паролем — будут случайные данные при каждом запуске.</string>
    <string name="title_pref_local_proxy_password">Пароль локального прокси</string>
    <string name="summary_pref_local_proxy_password">Необязательно. Задаётся вместе с логином для фиксированных учётных данных.</string>
    <string name="pref_local_proxy_password_masked">Сохранён (скрыт)</string>
    <string name="title_pref_show_proxy_credentials">Показать данные прокси</string>
    <string name="summary_pref_show_proxy_credentials">Показать текущие логин и пароль SOCKS/HTTP для использования прокси на других устройствах</string>
    <string name="proxy_credentials_title">Данные прокси</string>
    <string name="proxy_credentials_message">SOCKS5: 127.0.0.1:%1$d\nHTTP: 127.0.0.1:%2$d\nИмя пользователя: %3$s\nПароль: %4$s</string>
    <string name="proxy_credentials_message_socks_only">SOCKS5: 127.0.0.1:%1$d\nИмя пользователя: %2$s\nПароль: %3$s</string>
    <string name="proxy_credentials_not_active">Задайте логин и пароль выше или подключите VPN с включённой защитой локального прокси, чтобы увидеть сгенерированные данные.</string>
    <string name="proxy_credentials_copy">Копировать</string>
    <string name="proxy_credentials_copied">Данные скопированы в буфер обмена</string>

